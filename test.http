@baseUrl = http://68.221.175.88:5000/api

###############################################################################
# COMPREHENSIVE SUPERVISOR FEATURE TEST WORKFLOW
# This file tests the complete supervisor feature flow:
# 1. Student & Supervisor Auth
# 2. Supervisor adds student
# 3. Student approves supervisor
# 4. Student generates task via supervisor
# 5. Supervisor reviews & edits task
# 6. Student completes task
# 7. Supervisor views history
###############################################################################

###############################################################################
# ======== PHASE 1: STUDENT SETUP ========
###############################################################################

# Variables for Student
@studentFullName = Ahmad Jaber
@studentEmail = Ahmad.Jaber1@example.com
@studentPassword = StudentPass123!

###
# 1.1) STUDENT SIGNUP - Create new student account
# @name student_signup
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "fullName": "{{studentFullName}}",
  "email": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

###
# Capture student ID from signup
@studentId = {{student_signup.response.body.$.id}}

###
# 1.2) STUDENT SIGNIN - Authenticate student
# @name student_signin
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
  "email": "{{studentEmail}}",
  "password": "{{studentPassword}}"
}

###
# Capture student token
@studentToken = {{student_signin.response.body.$.token}}

###
# 1.3) VERIFY CURRENT STUDENT - Check logged-in student info
GET {{baseUrl}}/auth/me
Authorization: Bearer {{studentToken}}

###
# 1.4) SELECT PATH - Student selects a learning path
# Available pathId can be retrieved from GET /api/paths
# Using pathId = 1 for this test
# @name select_path
PUT {{baseUrl}}/auth/selected-path
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "selectedPathId": 1
}

###
# 1.5) GET PATHS - Get available paths (informational)
GET {{baseUrl}}/paths
Authorization: Bearer {{studentToken}}

###
# 1.6) GET SKILLS BY PATH - Get skills for path 1
GET {{baseUrl}}/skills/by-path/1
Authorization: Bearer {{studentToken}}

###
# 1.7) GET LEARNING OBJECTIVES - Get objectives for skill 4
GET {{baseUrl}}/learningobjectives/by-skill/4
Authorization: Bearer {{studentToken}}

###
# 1.8) SUBMIT WELCOME ASSESSMENT - Complete one-time assessment
# @name welcome_assessment
POST {{baseUrl}}/auth/welcome-assessment
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "objectives": [
    { "learningObjectiveId": 33, "score": 3 },
    { "learningObjectiveId": 34, "score": 2 },
    { "learningObjectiveId": 35, "score": 2 },
    { "learningObjectiveId": 36, "score": 2 },
    { "learningObjectiveId": 37, "score": 3 },
    { "learningObjectiveId": 38, "score": 2 },
    { "learningObjectiveId": 39, "score": 3 },
    { "learningObjectiveId": 40, "score": 2 }
  ]
}

###############################################################################
# ======== PHASE 2: SUPERVISOR SETUP ========
###############################################################################

# Variables for Supervisor
@supervisorFullName = Dr. Bob Smith
@supervisorEmail = bob.smith@university.edu
@supervisorPassword = SupervisorPass123!

###
# 2.1) SUPERVISOR SIGNUP - Create new supervisor account
# Note: Supervisor must select a pathId (path they manage)
# @name supervisor_signup
POST {{baseUrl}}/auth/supervisor-signup
Content-Type: application/json

{
  "fullName": "{{supervisorFullName}}",
  "email": "{{supervisorEmail}}",
  "password": "{{supervisorPassword}}",
  "PathId": 1
}

###
# Capture supervisor ID from signup
@supervisorId = {{supervisor_signup.response.body.$.supervisor.id}}

###
# 2.2) SUPERVISOR SIGNIN - Authenticate supervisor
# @name supervisor_signin
POST {{baseUrl}}/auth/supervisor-signin
Content-Type: application/json

{
  "email": "{{supervisorEmail}}",
  "password": "{{supervisorPassword}}"
}

###
# Capture supervisor token
@supervisorToken = {{supervisor_signin.response.body.$.token}}

###
# Capture supervisor ID from signin response (reliable on reruns when signup may fail)
@supervisorId = {{supervisor_signin.response.body.$.supervisor.id}}

###
# 2.3) VERIFY CURRENT SUPERVISOR - Check logged-in supervisor info
GET {{baseUrl}}/auth/supervisor-me
Authorization: Bearer {{supervisorToken}}

###############################################################################
# ======== PHASE 3: SUPERVISOR MANAGES STUDENT ========
###############################################################################

###
# 3.1) SUPERVISOR ADDS STUDENT - Supervisor invites student
# Send student email to add them to this supervisor's path
# @name add_student
POST {{baseUrl}}/supervisor/add-student
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
  "studentEmail": "{{studentEmail}}"
}

###
# Capture the supervisor-student relationship ID (if needed)
@supervisorStudentId = {{add_student.response.body.$.supervisorId}}

###
GET {{baseUrl}}/auth/supervisor-requests
Authorization: Bearer {{studentToken}}

###
# 3.2) STUDENT APPROVES SUPERVISOR - Student approves the supervisor invitation
# Endpoint: POST /api/auth/supervisor-requests/{supervisorId}/{pathId}/approve
# @name approve_supervisor
POST {{baseUrl}}/auth/supervisor-requests/{{supervisorId}}/1/approve
Authorization: Bearer {{studentToken}}

###
# 3.3) ALTERNATIVE: STUDENT REJECTS SUPERVISOR - Student rejects the supervisor invitation
# Endpoint: POST /api/auth/supervisor-requests/{supervisorId}/{pathId}/reject
# Uncomment to test rejection instead of approval
# @name reject_supervisor
# POST {{baseUrl}}/auth/supervisor-requests/{{supervisorId}}/1/reject
# Authorization: Bearer {{studentToken}}

###
# 3.4) SUPERVISOR VIEWS APPROVED STUDENTS - Verify student was added
GET {{baseUrl}}/supervisor/my-students
Authorization: Bearer {{supervisorToken}}

###############################################################################
# ======== PHASE 4: TASK GENERATION REQUEST WORKFLOW ========
###############################################################################

###
# 4.1) STUDENT TRIES DIRECT GENERATION - For supervised students this must auto-convert to a request
# Expected HTTP status: 202 Accepted with { mode: "supervisor_request", request: {...} }
# @name generate_task_supervised
POST {{baseUrl}}/task-generation/generate
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "studentId": "{{studentId}}",
  "mainSkillId": 1
}

###
# Capture the request ID from the conversion response
@requestId = {{generate_task_supervised.response.body.$.request.id}}

###
# 4.2) SUPERVISOR GETS ALL PENDING REQUESTS - List tasks to review
GET {{baseUrl}}/task-generation/requests
Authorization: Bearer {{supervisorToken}}

###
# 4.3) SUPERVISOR APPROVES + GENERATES + PERSISTS IN ONE STEP
# This creates TaskItem + StudentTask directly in DB and marks request approved.
# @name approve_generate_task
POST {{baseUrl}}/task-generation/requests/{{requestId}}/approve-and-generate
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{}

###
# Capture task ID
@taskId = {{approve_generate_task.response.body.$.taskId}}

###
# 4.4) GET FULL TASK PAYLOAD - This is the raw task JSON the student will use to solve the task
# @name get_full_task_payload
GET {{baseUrl}}/taskitems/{{taskId}}
Authorization: Bearer {{studentToken}}

###############################################################################
# ======== PHASE 6: SUPERVISOR EDITS TASK (do edits before student sees it) ========
###############################################################################

###
# 6.1) SUPERVISOR EDITS TASK OBJECTIVES - Change which objectives task targets
# @name edit_objectives
PUT {{baseUrl}}/tasks/{{taskId}}/objectives
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
  "objectiveIds": [1, 2, 5]
}

###
# 6.2) SUPERVISOR EDITS TASK PREREQUISITES - Change prerequisite skills required
# @name edit_prerequisites
PUT {{baseUrl}}/tasks/{{taskId}}/prerequisites
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
  "prerequisiteObjectiveIds": [1, 2]
}

###
# 6.3) SUPERVISOR EDITS TASK VALIDATIONS - Change validation criteria
# @name edit_validations
PUT {{baseUrl}}/tasks/{{taskId}}/validations
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
  "validations": [
    {
      "skillId": 1,
      "criterion": "Middleware is properly implemented and registered.",
      "relatedLearningObjective": 1
    },
    {
      "skillId": 1,
      "criterion": "Error handling returns appropriate HTTP status codes.",
      "relatedLearningObjective": 2
    },
    {
      "skillId": 1,
      "criterion": "Logging captures all required metadata.",
      "relatedLearningObjective": 5
    },
    {
      "skillId": 0,
      "criterion": "Code follows ASP.NET Core best practices.",
      "relatedLearningObjective": 0
    }
  ]
}

###############################################################################
# After supervisor edits, student can now view and work on the task
###############################################################################

###
# 6.4) GET FULL TASK PAYLOAD - This is the final raw task JSON the student will use to solve the task
# @name get_full_task_payload
GET {{baseUrl}}/taskitems/{{taskId}}
Authorization: Bearer {{studentToken}}

###############################################################################
# ======== PHASE 5: STUDENT COMPLETES TASK ========
###############################################################################

###
# 5.1) GET STUDENT TASKS -View assigned tasks 
GET {{baseUrl}}/studenttasks/by-student/{{studentId}}
Authorization: Bearer {{studentToken}}

###
# 5.2) GET TASK DETAILS - View full task with validation criteria
GET {{baseUrl}}/studenttasks/{{studentId}}/{{taskId}}/details
Authorization: Bearer {{studentToken}}

###
# 5.3) SUBMIT TASK SOLUTION - Student submits code and repository
# This endpoint submits the task completion for evaluation
# @name submit_task
POST {{baseUrl}}/StudentTasks/{{studentId}}/{{taskId}}/evaluate
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "repositoryUrl": "https://github.com/Ahmad-Jaber1/testRepo",
  "ref": "main"
}

###############################################################################
# ======== PHASE 7: SUPERVISOR VIEWS STUDENT PROGRESS ========
###############################################################################

###
# 7.1) SUPERVISOR VIEWS STUDENT TASK HISTORY - Get all tasks in a skill
# @name student_history
GET {{baseUrl}}/supervisor/students/{{studentId}}/skills/1/history
Authorization: Bearer {{supervisorToken}}

###
# 7.2) GET FULL TASK DETAILS - Supervisor views complete task evaluation
GET {{baseUrl}}/studenttasks/{{studentId}}/{{taskId}}/details
Authorization: Bearer {{supervisorToken}}

###############################################################################
# ======== ALTERNATIVE: REJECT TASK REQUEST ========
###############################################################################

###
# ALT-1) STUDENT REQUESTS ANOTHER TASK
# @name request_task_generation_2
POST {{baseUrl}}/task-generation/request
Authorization: Bearer {{studentToken}}
Content-Type: application/json

{
  "mainSkillId": 5
}

###
# Capture second request ID
@requestId2 = {{request_task_generation_2.response.body.$.id}}

###
# ALT-2) SUPERVISOR REJECTS THE REQUEST
POST {{baseUrl}}/task-generation/requests/{{requestId2}}/reject
Authorization: Bearer {{supervisorToken}}
Content-Type: application/json

{
}

###############################################################################
# ======== NOTES FOR FRONTEND DEVELOPERS ========
###############################################################################

# Key Behavioral Notes:
# 1. Student must select a path before generating tasks
# 2. Student must complete welcome assessment before generating tasks
# 3. Supervisor must be in Approved status (automatic if student exists)
# 4. When a task is edited by supervisor, SupervisorEdited flag = true
# 5. Tasks with SupervisorEdited = true are excluded from future auto-generation
# 6. LastSubmittedRepositoryUrl is stored per StudentTask, not per evaluation
# 7. Task generation request status flows: Pending -> Approved OR Rejected
# 8. Supervisor can only view students they are assigned to
# 9. Each supervisor can manage only one path
# 10. Student-Supervisor relationship is one-to-one per path

# Error Scenarios to Test:
# - Student tries to generate task without selecting path (400)
# - Student tries to generate task without supervisor (400)
# - Supervisor tries to approve rejected request (400)
# - Supervisor tries to view another supervisor's student (403)
# - Invalid objective IDs in edit endpoints (400)
# - Prerequisite objectives from same skill as main skill (400)

###
GET {{baseUrl}}/studenttasks/by-student/{{studentId}}/skill/1
Authorization: Bearer {{studentToken}}
Content-Type: application/json
###
GET {{baseUrl}}/studenttasks/{{studentId}}/{{taskId}}/details
Authorization: Bearer {{studentToken}}
Content-Type: application/json